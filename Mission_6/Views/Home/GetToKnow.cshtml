@{
    ViewData["Title"] = "Get to Know Joel";
}

<div class="text-center mt-5">
    <h1 class="display-4 fw-bold">@ViewData["Title"]</h1>
    <p class="lead text-muted">Explore some of his passion projects!</p>
    <hr class="my-4 w-50 mx-auto" />
</div>

<div class="row justify-content-center mt-4">
    <div class="col-md-5 text-center mb-4">
        <h3 class="fw-bold">Quick Wits Comedy</h3>
        <p class="text-muted">Where Joel performs regularly — live improv comedy at its finest.</p>
        <a href="https://www.qwcomedy.com/" target="_blank" class="btn btn-outline-dark">Visit Quick Wits</a>
    </div>

    <div class="col-md-5 text-center mb-4">
        <h3 class="fw-bold">Baconsale</h3>
        <p class="text-muted">A weekly podcast about films & pop culture.</p>
        <a href="https://baconsale.com/" target="_blank">
            <img src="~/img/baconsalekate.jpg" class="rounded shadow img-fluid" alt="Baconsale Podcast"
                 style="max-height: 350px;" />
        </a>
        <div class="mt-3">
            <a href="https://baconsale.com/" target="_blank" class="btn btn-outline-dark">Visit Baconsale</a>
        </div>
    </div>
</div>