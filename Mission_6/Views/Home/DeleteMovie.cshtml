@{
}

@model Mission06_Evans.Models.Movie

@{
    ViewData["Title"] = "Delete Movie";
}

<h1>Are you sure you want to delete this movie?</h1>

<div class="card mt-3" style="max-width: 500px;">
    <div class="card-body">
        <h5 class="card-title">@Model.Title</h5>
        <p><strong>Year:</strong> @Model.Year</p>
        <p><strong>Director:</strong> @Model.Director</p>
        <p><strong>Rating:</strong> @Model.Rating</p>
        <p><strong>Edited:</strong> @(Model.Edited == true ? "Yes" : "No")</p>
        <p><strong>Copied to Plex:</strong> @(Model.CopiedToPlex == true ? "Yes" : "No")</p>
        <p><strong>Notes:</strong> @Model.Notes</p>
    </div>
</div>

<form method="post">
    <input type="hidden" asp-for="MovieId" />
    <button type="submit" class="btn btn-danger mt-3">Yes, Delete</button>
    <a asp-action="MovieList" class="btn btn-secondary mt-3">Cancel</a>
</form>