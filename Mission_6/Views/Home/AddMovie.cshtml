
@model Mission06_Evans.Models.Movie
@{
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<h1>Add your movie to the roster!</h1>
<form method="post" novalidate>
    <label asp-for="Category"></label>
    <input asp-for="Category" />
    <span asp-validation-for="Category" style="color:red"></span>
    <br />
    <label asp-for="Title"></label>
    <input asp-for="Title" />
    <span asp-validation-for="Title" style="color:red"></span>
    <br />
    <label asp-for="Year"></label>
    <input asp-for="Year" />
    <span asp-validation-for="Year" style="color:red"></span>
    <br />
    <label asp-for="Director"></label>
    <input asp-for="Director" />
    <span asp-validation-for="Director" style="color:red"></span>
    <br />
    <label asp-for="Rating"></label>
    <select asp-for="Rating">
        <option value="">-- Select Rating --</option>
        <option value="G">G</option>
        <option value="PG">PG</option>
        <option value="PG-13">PG-13</option>
        <option value="R">R</option>
    </select>
    <span asp-validation-for="Rating" style="color:red"></span>
    <br />
    <label asp-for="Edited"></label>
    <select asp-for="Edited">
        <option value="">-- Select --</option>
        <option value="true">Yes</option>
        <option value="false">No</option>
    </select>
    <br />
    <label asp-for="LentTo"></label>
    <input asp-for="LentTo" />
    <br />
    <label asp-for="Notes"></label>
    <input asp-for="Notes" />
    <br />
    <button type="submit">Submit</button>
</form>